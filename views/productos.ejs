
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova Salud - Inventario de Productos</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            background: #f1f5f9;
            color: #1e293b;
            padding: 30px 20px;
        }

        .container {
            max-width: 1000px;
            margin: 30px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
        }

        .nav {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            padding-bottom: 20px;
            margin-bottom: 25px;
            border-bottom: 1px solid #e2e8f0;
        }

        .nav a {
            text-decoration: none;
            color: #475569;
            font-size: 14px;
            padding: 9px 12px;
            border-radius: 6px;
        }

        .nav a:hover,
        .nav a.activo {
            background: #eff6ff;
            color: #2563eb;
        }

        h2 {
            font-size: 22px;
            margin-bottom: 8px;
            color: #1e293b;
        }

        .descripcion {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .formulario {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 22px;
            border-radius: 8px;
            margin-bottom: 25px;
        }

        h3 {
            font-size: 16px;
            color: #334155;
            margin-bottom: 18px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #334155;
        }

        input {
            width: 100%;
            padding: 12px;
            background: white;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            color: #1e293b;
            font-size: 14px;
            outline: none;
        }

        input:focus {
            border-color: #3b82f6;
        }

        .btn-guardar {
            padding: 12px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            margin-top: 24px;
        }

        .btn-guardar:hover {
            background: #1d4ed8;
        }

        #mensaje {
            display: none;
            margin-bottom: 20px;
            padding: 13px;
            border-radius: 7px;
            font-size: 14px;
        }

        .tabla-contenedor {
            width: 100%;
            overflow-x: auto;
        }

        .tabla-titulo {
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            min-width: 600px;
        }

        th, td {
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
            font-size: 14px;
        }

        th {
            color: #64748b;
            background: #f8fafc;
            font-weight: 600;
        }

        td {
            color: #334155;
        }

        .badge {
            display: inline-block;
            background: #dcfce7;
            color: #15803d;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-danger {
            background: #fee2e2;
            color: #b91c1c;
        }

        @media (max-width: 600px) {
            .container {
                padding: 20px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .btn-guardar {
                margin-top: 0;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="nav">
            <a href="/view-venta">Registrar Venta</a>
            <a href="/view-productos" class="activo">Inventario</a>
            <a href="/view-alertas">Alertas de Stock</a>
        </div>

        <h2>Gestión de inventario</h2>
        <p class="descripcion">Registre nuevos productos y consulte las existencias disponibles.</p>

        <div class="formulario">

            <h3>Agregar producto</h3>

            <div class="form-grid">

                <div class="form-group">
                    <label for="nombre">Nombre del producto</label>
                    <input type="text" id="nombre">
                </div>

                <div class="form-group">
                    <label for="marca">Marca</label>
                    <input type="text" id="marca">
                </div>

                <div class="form-group">
                    <label for="precio">Precio (S/)</label>
                    <input type="number" id="precio" step="0.10" min="0">
                </div>

                <div class="form-group">
                    <label for="stock">Stock inicial</label>
                    <input type="number" id="stock" min="0">
                </div>

                <div class="form-group">
                    <label for="stockMinimo">Stock mínimo</label>
                    <input type="number" id="stockMinimo" min="0">
                </div>

                <div class="form-group">
                    <button class="btn-guardar" onclick="agregarProducto()">
                        Guardar producto
                    </button>
                </div>

            </div>
        </div>

        <div id="mensaje"></div>

        <div class="tabla-titulo">
            <h3>Productos registrados</h3>
        </div>

        <div class="tabla-contenedor">
            <table>
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Marca</th>
                        <th>Precio</th>
                        <th>Stock actual</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody id="tablaBody">
                    <tr>
                        <td colspan="5" style="text-align:center;">
                            Cargando inventario...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

    <script>
        const token = localStorage.getItem('mi_token');

        if (!token) window.location.href = '/view-login';

        function cargarProductos() {
            fetch('/productos', {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            })
            .then(res => res.json())
            .then(productos => {
                const tbody = document.getElementById('tablaBody');
                tbody.innerHTML = '';

                if (productos.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" style="text-align:center;">
                                No hay productos registrados.
                            </td>
                        </tr>
                    `;
                    return;
                }

                productos.forEach(p => {
                    const esBajoStock = p.stock <= p.stockMinimo;
                    const badgeClass = esBajoStock ? 'badge badge-danger' : 'badge';
                    const estado = esBajoStock ? 'Bajo Stock' : 'Óptimo';

                    tbody.innerHTML += `
                        <tr>
                            <td>${p.nombre}</td>
                            <td>${p.marca || '-'}</td>
                            <td>S/ ${p.precio}</td>
                            <td style="font-weight:600; color:${esBajoStock ? '#dc2626' : '#334155'}">
                                ${p.stock}
                            </td>
                            <td>
                                <span class="${badgeClass}">${estado}</span>
                            </td>
                        </tr>
                    `;
                });
            })
            .catch(err => {
                console.log(err);
            });
        }

        cargarProductos();

        async function agregarProducto() {
            const msj = document.getElementById('mensaje');

            const data = {
                nombre: document.getElementById('nombre').value,
                marca: document.getElementById('marca').value,
                precio: parseFloat(document.getElementById('precio').value),
                stock: parseInt(document.getElementById('stock').value),
                stockMinimo: parseInt(document.getElementById('stockMinimo').value)
            };

            if (!data.nombre || isNaN(data.precio)) {
                return alert("Complete los campos obligatorios");
            }

            try {
                const res = await fetch('/productos', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(data)
                });

                msj.style.display = 'block';

                if (res.ok) {
                    msj.style.background = '#dcfce7';
                    msj.style.color = '#15803d';
                    msj.innerText = 'Producto registrado correctamente';

                    document.getElementById('nombre').value = '';
                    document.getElementById('marca').value = '';
                    document.getElementById('precio').value = '';
                    document.getElementById('stock').value = '';
                    document.getElementById('stockMinimo').value = '';

                    cargarProductos();

                } else {
                    const error = await res.json();

                    msj.style.background = '#fee2e2';
                    msj.style.color = '#b91c1c';
                    msj.innerText = error.error || 'Error al guardar';
                }

            } catch (err) {
                msj.style.display = 'block';
                msj.style.background = '#fee2e2';
                msj.style.color = '#b91c1c';
                msj.innerText = 'Error de conexión';
            }
        }
    </script>

</body>
</html>
